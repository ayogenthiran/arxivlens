# Local process binds to loopback. Docker Compose overrides HOST to 0.0.0.0.
HOST=127.0.0.1
PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
UI_PORT=8501

DATA_DIR=data/raw
OUTPUT_DIR=data/processed
VECTOR_STORE_DIR=data/vector_store
CHROMA_COLLECTION_NAME=documents
ANONYMIZED_TELEMETRY=false

OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_REQUEST_TIMEOUT_S=15
ENABLE_QUERY_REWRITE=false
QUERY_REWRITE_MODEL=gpt-3.5-turbo
QUERY_REWRITE_TEMPERATURE=0.0
QUERY_REWRITE_MAX_TOKENS=64

MAX_QUERY_TOP_K=20
UI_DEFAULT_TOP_K=8
UI_MIN_TOP_K=3
UI_MAX_TOP_K=20
YEAR_MIN_BOUND=1900
YEAR_MAX_BOUND=2100
HYBRID_BM25_MAX_DOCS=50000
RRF_K=60
RETRIEVAL_CANDIDATE_MULTIPLIER=8
RETRIEVAL_FILTER_CANDIDATE_MULTIPLIER=40
RETRIEVAL_FILTER_CANDIDATE_FLOOR=200
FACET_TOP_AUTHORS=10

# Active research corpus. data/vector_store stays the full archive.
# Keep MAX_DOCS under HYBRID_BM25_MAX_DOCS so BM25 can stay on as the corpus grows.
# OUTPUT_DIR=data/processed_corpus
# VECTOR_STORE_DIR=data/vector_store_corpus
# MAX_DOCS=5000
# INGEST_CATEGORIES=cs.CL,cs.LG
# INGEST_YEAR_MIN=2024
# RESET_INGEST=false
MAX_DOCS=0
INGEST_BATCH_DOCS=250
INGEST_CATEGORIES=
INGEST_YEAR_MIN=0
RESET_INGEST=false
INGEST_RETRY_MAX_ATTEMPTS=4
INGEST_RETRY_BASE_DELAY_S=1.0
INGEST_JSONL_STREAM_MIN_BYTES=50000000
INGEST_MODERN_SNAPSHOT_FRACTION=0.90
INGEST_YEAR_SEEK_WINDOW_BYTES=1000000

ENABLE_RERANKER=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_CANDIDATES=24
# Drop reranked chunks whose raw cross-encoder score is below this.
# A score near 0 goes away. A score around 5 stays.
RERANKER_MIN_RAW_SCORE=1

API_QUERY_TIMEOUT_S=60
UI_CONFIDENCE_HIGH=0.72
UI_CONFIDENCE_MEDIUM=0.45
UI_FACET_LIMIT=5
UI_MAX_AUTHORS_SHOWN=3
ARXIV_ABS_BASE_URL=https://arxiv.org/abs

EVAL_SUPPORT_THRESHOLD=0.55
CITATION_GROUNDEDNESS_MIN=0.8
